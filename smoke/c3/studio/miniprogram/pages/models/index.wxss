.models-page {
  padding-bottom: 70rpx;
}

.hero,
.settings-card,
.model-card,
.message-card {
  padding: 28rpx;
}

.hero {
  background:
    radial-gradient(circle at 90% 12%, rgba(167, 139, 250, 0.2), transparent 38%),
    linear-gradient(135deg, rgba(49, 46, 129, 0.48), rgba(15, 30, 48, 0.94));
}

.hero-title {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 880;
}

.hero-copy {
  margin-top: 15rpx;
  color: #b7c8dc;
  font-size: 22rpx;
  line-height: 1.65;
}

.engine-status {
  display: flex;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid rgba(251, 113, 133, 0.3);
  border-radius: 16rpx;
  color: #fecdd3;
  background: rgba(76, 5, 25, 0.42);
  font-size: 20rpx;
}

.engine-status.supported {
  border-color: rgba(34, 197, 94, 0.3);
  color: #bbf7d0;
  background: rgba(20, 83, 45, 0.34);
}

.settings-card {
  margin-top: 22rpx;
}

.field-label {
  display: block;
  margin: 20rpx 0 10rpx;
  color: #a9bad0;
  font-size: 21rpx;
}

.url-input {
  height: 72rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  color: #e6f4ff;
  background: rgba(2, 8, 16, 0.58);
  font-size: 21rpx;
}

.threshold-settings {
  margin-top: 24rpx;
}

.threshold-settings > view {
  display: flex;
  justify-content: space-between;
  color: #b8c8d9;
  font-size: 21rpx;
}

.threshold-settings slider {
  margin: 4rpx 0 12rpx;
}

.save-button {
  width: 100%;
  margin-top: 18rpx;
}

.settings-note {
  margin-top: 18rpx;
  color: #7890a9;
  font-size: 19rpx;
  line-height: 1.55;
}

.model-section-title {
  margin-top: 30rpx;
}

.model-card {
  position: relative;
  margin-top: 16rpx;
  overflow: hidden;
}

.model-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.model-title,
.model-note {
  display: block;
}

.model-title {
  font-size: 28rpx;
  font-weight: 800;
}

.model-note {
  margin-top: 7rpx;
  color: var(--muted);
  font-size: 19rpx;
}

.cache-pill {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #fcd34d;
  background: rgba(120, 53, 15, 0.44);
  font-size: 18rpx;
}

.cache-pill.cached {
  color: #86efac;
  background: rgba(20, 83, 45, 0.44);
}

.model-meta {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.model-meta text {
  padding: 7rpx 12rpx;
  border-radius: 10rpx;
  color: #bae6fd;
  background: rgba(14, 116, 144, 0.2);
  font-size: 18rpx;
}

.hash-line {
  margin-top: 16rpx;
  color: #6f859d;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 18rpx;
}

.model-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
}

.model-actions button {
  flex: 1;
  margin: 0;
  padding: 0 12rpx;
  font-size: 19rpx;
}

.download-progress {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 7rpx;
  background: rgba(148, 163, 184, 0.16);
}

.download-fill {
  height: 100%;
  background: #38bdf8;
}

.message-card {
  margin-top: 22rpx;
  color: #c7e9f9;
  font-size: 21rpx;
  line-height: 1.55;
}
