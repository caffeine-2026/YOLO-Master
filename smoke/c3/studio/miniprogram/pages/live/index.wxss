.live-page {
  height: calc(100vh - 0px);
  overflow: hidden;
  background: #02070d;
}

.camera-shell {
  position: relative;
  height: calc(100vh - 112rpx);
  overflow: hidden;
  background: #02070d;
}

.camera-preview,
.overlay-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.overlay-canvas {
  z-index: 2;
  pointer-events: none;
}

.top-hud {
  position: absolute;
  z-index: 4;
  top: 24rpx;
  left: 24rpx;
  right: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 22rpx;
  backdrop-filter: blur(20px);
}

.model-picker {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.picker-label {
  color: #38bdf8;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.picker-value {
  max-width: 390rpx;
  overflow: hidden;
  color: #f8fbff;
  font-size: 27rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.backend-pill {
  padding: 10rpx 16rpx;
  border: 1rpx solid rgba(248, 113, 113, 0.36);
  border-radius: 999rpx;
  color: #fca5a5;
  background: rgba(127, 29, 29, 0.38);
  font-size: 20rpx;
  font-weight: 700;
}

.backend-pill.ready {
  border-color: rgba(34, 197, 94, 0.36);
  color: #86efac;
  background: rgba(20, 83, 45, 0.44);
}

.camera-controls {
  position: absolute;
  z-index: 4;
  top: 145rpx;
  left: 50%;
  display: flex;
  gap: 14rpx;
  align-items: center;
  padding: 12rpx;
  transform: translateX(-50%);
  backdrop-filter: blur(20px);
}

.round-control,
.run-control {
  height: 68rpx;
  margin: 0;
  padding: 0 28rpx;
  color: #dbeafe;
  background: rgba(30, 64, 96, 0.76);
  font-size: 22rpx;
  line-height: 68rpx;
}

.run-control {
  min-width: 150rpx;
  color: #04111e;
  background: linear-gradient(135deg, #67e8f9, #38bdf8);
}

.run-control.pause {
  color: white;
  background: linear-gradient(135deg, #fb7185, #ef4444);
}

.loading-banner,
.error-banner {
  position: absolute;
  z-index: 5;
  top: 245rpx;
  left: 50%;
  width: 520rpx;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  transform: translateX(-50%);
  text-align: center;
  backdrop-filter: blur(20px);
}

.progress-track {
  height: 8rpx;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 99rpx;
  background: rgba(148, 163, 184, 0.2);
}

.progress-fill {
  height: 100%;
  border-radius: 99rpx;
  background: #38bdf8;
}

.error-banner {
  color: #fecdd3;
  background: rgba(76, 5, 25, 0.86);
}

.error-link {
  display: block;
  margin-top: 8rpx;
  color: #7dd3fc;
}

.stats-hud {
  position: absolute;
  z-index: 4;
  right: 24rpx;
  bottom: 28rpx;
  left: 24rpx;
  display: grid;
  grid-template-columns: 150rpx 1fr 110rpx;
  gap: 24rpx;
  align-items: center;
  padding: 22rpx 28rpx;
  backdrop-filter: blur(22px);
}

.fps-gauge,
.detection-count {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.fps-number,
.detection-number {
  color: #67e8f9;
  font-size: 54rpx;
  font-weight: 850;
  line-height: 1;
}

.fps-label,
.detection-label {
  margin-top: 6rpx;
  color: #8fa3bb;
  font-size: 20rpx;
}

.detection-number {
  color: #4ade80;
}

.timing-grid {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.timing-row {
  display: flex;
  justify-content: space-between;
  color: #a9bad0;
  font-size: 21rpx;
}

.timing-row.total {
  color: white;
  font-weight: 750;
}

.threshold-bar {
  display: grid;
  grid-template-columns: 130rpx 1fr 70rpx;
  align-items: center;
  height: 112rpx;
  box-sizing: border-box;
  padding: 0 30rpx;
  color: #a9bad0;
  background: #081421;
  font-size: 22rpx;
}

.threshold-bar slider {
  width: 100%;
  margin: 0;
}
