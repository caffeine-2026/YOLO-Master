.photo-page {
  padding-bottom: 60rpx;
}

.page-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 16rpx 4rpx 24rpx;
}

.title {
  margin-top: 8rpx;
  font-size: 38rpx;
  font-weight: 850;
}

.subtitle {
  margin-top: 8rpx;
  font-size: 21rpx;
}

.model-chip {
  max-width: 280rpx;
  padding: 14rpx 18rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  color: #bae6fd;
  background: rgba(14, 116, 144, 0.2);
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-card {
  position: relative;
  height: 690rpx;
  overflow: hidden;
  background: #030911;
}

.preview-image,
.preview-overlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.preview-overlay {
  z-index: 2;
  pointer-events: none;
}

.empty-preview {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: var(--muted);
  font-size: 24rpx;
}

.empty-icon {
  color: #38bdf8;
  font-size: 90rpx;
  font-weight: 200;
}

.action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin: 22rpx 0;
}

.action-row button {
  width: 100%;
  margin: 0;
}

.progress-card,
.error-card,
.results-card {
  margin-top: 20rpx;
  padding: 24rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
}

.progress-track {
  height: 10rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(148, 163, 184, 0.18);
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #22d3ee, #38bdf8);
}

.error-card {
  color: #fecdd3;
  border-color: rgba(251, 113, 133, 0.28);
  background: rgba(76, 5, 25, 0.54);
  font-size: 22rpx;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 22rpx;
}

.summary-item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  align-items: center;
  padding: 22rpx 10rpx;
}

.summary-number {
  color: #f8fafc;
  font-size: 38rpx;
  font-weight: 850;
}

.summary-number.green {
  color: #4ade80;
}

.summary-number.cyan {
  color: #67e8f9;
}

.result-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--line);
}

.result-name,
.result-backend {
  display: block;
  max-width: 390rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-name {
  font-size: 23rpx;
  font-weight: 700;
}

.result-backend {
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 19rpx;
}

.result-metrics {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  align-items: flex-end;
  color: #bae6fd;
  font-size: 20rpx;
}
